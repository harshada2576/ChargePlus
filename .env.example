# ==============================================================================
# CHARGEPLUS — ENVIRONMENT VARIABLES & SECRETS CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env.local or any real secrets to version control.
# 2. Variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
#    ONLY public-safe credentials may use NEXT_PUBLIC_.
# 3. Privileged keys (service_role, database passwords, API tokens) must NEVER
#    be prefixed with NEXT_PUBLIC_ or imported into browser-executed components.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. OPERATIONAL MODE (DEMO vs PRODUCTION)
# ------------------------------------------------------------------------------
# Set to "true" to run in offline Demo Mode using verified local seed fixtures
# without requiring an external Supabase cloud project or third-party SMS delivery.
# In production, set to "false" (or leave unset); production fails closed if
# cloud credentials or database connections are unconfigured.
NEXT_PUBLIC_DEMO_MODE="false"

# ------------------------------------------------------------------------------
# 1. PUBLIC-SAFE CLIENT CREDENTIALS (EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase public anonymous API key (anon key)
# Browser queries are strictly governed by PostgreSQL Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional publishable key alias (if configured in your client environment)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY / PRIVILEGED CREDENTIALS (NEVER EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string
# Used exclusively by server-side database pool (src/db/index.ts) and health checks.
# NEVER import into client components.
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# Supabase service-role API key
# Grants BYPASSRLS privileges. Used exclusively by server-side workers, administrative
# scripts, and future Python ETL pipelines. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. AUTH & SMS PROVIDER CONFIGURATION (SERVER-ONLY / DASHBOARD MANAGED)
# ------------------------------------------------------------------------------
# ChargePlus authentication uses passwordless Phone/Email OTP.
# Phone SMS delivery is managed natively via Supabase Auth (Twilio / MessageBird
# configured in the Supabase Dashboard under Authentication -> Providers -> Phone).
# If custom server-side SMS integration is added in future phases, supply:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 4. DATA INGESTION & EXTERNAL DATA SOURCES (SERVER-ONLY / PYTHON ETL)
# ------------------------------------------------------------------------------
# OpenChargeMap API key
# Used exclusively by server-side Python ingestion adapters (backend/ingestion/adapters/openchargemap.py).
# Request a key at: https://openchargemap.org/site/develop/api
# NEVER expose to client components or commit real keys to Git.
OPENCHARGEMAP_API_KEY="your-openchargemap-api-key"

# OpenStreetMap Overpass endpoint (secondary source: OSM community inventory)
# Used exclusively by server-side Python ingestion (backend/ingestion/adapters/osm.py).
# Default points at public Overpass infrastructure; override only with an approved
# endpoint or regional mirror. Bounding-box queries only — global extracts prohibited.
# OSM is manual/dry-run until validated; it is NOT cron-scheduled by default.
OSM_OVERPASS_ENDPOINT="https://overpass-api.de/api/interpreter"

# data.gov.in Open Government Data API key (secondary source: government registry)
# Used exclusively by server-side Python ingestion (backend/ingestion/adapters/datagovin.py).
# Register at https://data.gov.in to obtain a key. NEVER commit real keys to Git.
# Manual/dry-run until validated; NOT cron-scheduled by default.
DATAGOVIN_API_KEY="your-datagovin-api-key"

# data.gov.in dataset resource identifier for the verified EV-charging dataset.
# Resource IDs change over time — verify at https://data.gov.in before use.
# Until a verified ID is configured, the adapter fails closed with a clear
# BLOCKED_EXTERNAL_DEPENDENCY error and ingests nothing.
DATAGOVIN_RESOURCE_ID=""

# ------------------------------------------------------------------------------
# 5. ML TRAINING & INFERENCE (SERVER-ONLY / PYTHON)
# ------------------------------------------------------------------------------
# Model artifact directory (file-based approved-model registry root).
# Served only by server-side Python (backend/ml) and the /api/ml/* routes.
# NEVER expose artifact bytes, registry credentials, or control tables to clients.
ML_ARTIFACT_DIR="backend/ml/artifacts"

# Python executable used by the /api/ml/predict route to invoke the inference CLI.
# Defaults to "python" on Windows, "python3" elsewhere when unset.
# PYTHON_BIN="python3"

# ------------------------------------------------------------------------------
# 6. CPO PARTNER INTEGRATIONS — OCPI 2.2.1 / OICP 2.3 (SERVER-ONLY)
# ------------------------------------------------------------------------------
# One variable group per partner+environment. Prefix pattern:
#   {PROTOCOL}_{PARTNER}_{ENV}  (e.g. OCPI_TATAPOWER_SANDBOX, OICP_HUBJECT_PROD)
# Required per group: _ENDPOINT (partner interface base URL), _TOKEN (credential).
# Optional per group: _TOKEN_EXPIRES_AT (ISO-8601), _COUNTRY_CODE/_PARTY_ID
# (expected OCPI party scope; enforced as partner isolation).
#
# Every partner starts NOT_CONFIGURED. Sandbox and production credentials must
# differ — never reuse a sandbox token in production. See docs/cpo_partners.md
# for the activation checklist. NEVER commit real credentials.
#
# OCPI_TATAPOWER_SANDBOX_ENDPOINT="https://sandbox.example-cpo.com/ocpi"
# OCPI_TATAPOWER_SANDBOX_TOKEN="sandbox-token-from-partner"
# OCPI_TATAPOWER_SANDBOX_TOKEN_EXPIRES_AT=""
# OCPI_TATAPOWER_SANDBOX_COUNTRY_CODE="IN"
# OCPI_TATAPOWER_SANDBOX_PARTY_ID="TAT"

