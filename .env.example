# ==============================================================================
# CHARGEPLUS — ENVIRONMENT VARIABLES & SECRETS CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env.local or any real secrets to version control.
# 2. Variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
#    ONLY public-safe credentials may use NEXT_PUBLIC_.
# 3. Privileged keys (service_role, database passwords, API tokens) must NEVER
#    be prefixed with NEXT_PUBLIC_ or imported into browser-executed components.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC-SAFE CLIENT CREDENTIALS (EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase public anonymous API key (anon key)
# Browser queries are strictly governed by PostgreSQL Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional publishable key alias (if configured in your client environment)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY / PRIVILEGED CREDENTIALS (NEVER EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string
# Used exclusively by server-side database pool (src/db/index.ts) and health checks.
# NEVER import into client components.
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# Supabase service-role API key
# Grants BYPASSRLS privileges. Used exclusively by server-side workers, administrative
# scripts, and future Python ETL pipelines. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. AUTH & SMS PROVIDER CONFIGURATION (SERVER-ONLY / DASHBOARD MANAGED)
# ------------------------------------------------------------------------------
# ChargePlus authentication uses passwordless Phone/Email OTP.
# Phone SMS delivery is managed natively via Supabase Auth (Twilio / MessageBird
# configured in the Supabase Dashboard under Authentication -> Providers -> Phone).
# If custom server-side SMS integration is added in future phases, supply:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 4. DATA INGESTION & EXTERNAL DATA SOURCES (SERVER-ONLY / PYTHON ETL)
# ------------------------------------------------------------------------------
# OpenChargeMap API key
# Used exclusively by server-side Python ingestion adapters (backend/ingestion/adapters/openchargemap.py).
# Request a key at: https://openchargemap.org/site/develop/api
# NEVER expose to client components or commit real keys to Git.
OPENCHARGEMAP_API_KEY="your-openchargemap-api-key"

